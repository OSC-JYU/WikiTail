# Server
PORT=3000
# "dev" (single fixed local user, no proxy needed) or "header" (trust the `mail` header from SSO/reverse proxy)
AUTH_MODE=dev
DEV_USER_EMAIL=dev@wikitail.local
# Comma-separated emails auto-promoted to admin on first login. In AUTH_MODE=dev, DEV_USER_EMAIL is admin by default.
ADMIN_EMAILS=
DB_PATH=data/wikitail.db
UPLOADS_DIR=uploads

# Language used for projects created without one, and for searches with no article context.
# Content languages themselves are free-form ISO codes declared per project.
DEFAULT_LANGUAGE=en

# Wikipedia source adapter
WIKIPEDIA_USER_AGENT=Wikitail/0.1 (local dev; contact: admin@wikitail.local)

# Snapshot rendering width for Commons imports (originals can be 8+ MB).
COMMONS_IMAGE_WIDTH=1600
# Ceiling on how large an imported source can be.
MAX_IMPORT_BYTES=26214400
# Ceiling on a user upload — video is the reason this is larger.
MAX_UPLOAD_BYTES=209715200

# ---- Production (Docker / Podman) ------------------------------------------
# In the container the paths are absolute and AUTH_MODE=header is assumed:
#   AUTH_MODE=header
#   DB_PATH=/data/wikitail.db
#   UPLOADS_DIR=/uploads
# These are set for you in deploy/quadlet/wikitail.container — no need to
# duplicate them in a .env file when running under systemd.

